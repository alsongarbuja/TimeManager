@using TimeManager.Backend.ViewModels.PartialViews
@using TimeManager.Backend.Models.Responses
@using TimeManager.Backend.ViewModels
@model PagedResponse<ProfileTemplateViewModel>

@{
    Layout = "_ListWrapper";
    ViewData["Title"] = "Profile Group";

    List<string> Headers = ["Unit", "Role", "Shift Start Time", "Early Clock in buffer"];
    List<string> OrderingKeys = ["Unit", "Role"];
    ViewData["Headers"] = Headers;
    ViewData["ModuleTitle"] = "Profile Group";
    ViewData["ModuleDesc"] = "Manage the profile group in the department";
    ViewData["Controller"] = "ProfileTemplate";
    ViewData["DataCount"] = Model.Data.Count();

    ViewData["HasPagination"] = true;
    ViewData["OrderingKeys"] = OrderingKeys;
    ViewData["TotalPages"] = Model.TotalPages;
    ViewData["TotalRecords"] = Model.TotalRecords;

    int offset = (Model.PageNumber - 1) * Model.PageSize;
}

@foreach (var d in Model.Data)
{
    <tr class="table-row">
        <sn-cell counter-name="ProfileTemplate" start="@offset" />
        <td class="table-cell">@d.Unit</td>
        <td class="table-cell">@d.Role</td>
        <td class="table-cell">@d.ShiftStartTime</td>
        <td class="table-cell">@d.EarlyClockInBufferMin min</td>
        @await Html.PartialAsync("ActionTd", new ActionTdViewModel
        {
            Controller = "ProfileTemplate",
            Id = d.Id,
        })
    </tr>
}