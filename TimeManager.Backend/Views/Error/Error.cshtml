@using TimeManager.Backend.Common

@{
    Layout = "_MainLayout";
    ViewData["Title"] = "Error";
}

@section styles {
    <link rel="stylesheet" href="/css/extra-pages.css" />
}

<div class="main-container">
    <h2 class="title-text">Oops! - Error</h2>
    <p class="desc-text">There is some error in the system please try again or contact IT.</p>
    @if (User.IsInRole(AppConstants.SUPER_ADMIN_ROLE))
    {
        <a href="/app/dashboard/setup" class="btn">Go back to Dashboard</a>
    }
    else
    {
        <a href="/app/dashboard" class="btn">Go Back to Dashboard</a>
    }
</div>
