@model TimeManager.Backend.ViewModels.PartialViews.BulkUserCreateViewModel;

<div class="modal-content">
    <button class="btn-modal btn-modal-close"><i class="ri-close-circle-line"></i></button>

    <h3>Add Users in bulk</h3>

    <a href="~/assets/timemanager_user_bulk_import_example.xlsx" download>Download example file <i class="ri-download-line"></i></a>

    <form asp-controller="User" asp-action="BulkCreate" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <custom-input asp-for="ExcelFile" />

        <custom-select asp-for="DepartmentId" asp-items="@Model.Departments" />

        <button type="submit" class="btn btn-primary w-full">Submit</button>
    </form>
</div>