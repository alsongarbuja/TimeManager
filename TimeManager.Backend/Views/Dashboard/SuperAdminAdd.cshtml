@model TimeManager.Backend.ViewModels.RegisterSuperAdminModel;

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard - Add superadmin";
}

@section scripts {
    <script src="/js/passwordtoggle.js" defer></script>
}

<div>
    <h3>Add a super admin</h3>
    <form asp-controller="Dashboard" asp-action="SuperAdminAdd" method="post" class="space-y-6">
        @Html.AntiForgeryToken()

        <custom-input asp-for="Email" />
        <custom-input asp-for="Password"required="true" />
        <custom-input asp-for="ConfirmPassword" required="true" />

        <button type="submit" class="btn btn-primary">Submit</button>
    </form>
</div>
