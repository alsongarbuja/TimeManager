@using TimeManager.Backend.ViewModels.PartialViews
@using TimeManager.Backend.ViewModels
@model IEnumerable<DepartmentViewModel>

@{
    Layout = "_ListWrapper";
    ViewData["Title"] = "Department";

    List<string> Headers = ["Name", "Description"];
    ViewData["Headers"] = Headers;
    ViewData["ModuleTitle"] = "Department";
    ViewData["ModuleDesc"] = "Manage the department data in the system";
    ViewData["Controller"] = "Department";
    ViewData["DataCount"] = Model.Count();
}

@foreach (var d in Model)
{
    <tr class="table-row">
        <sn-cell counter-name="Department" start="0" />
        <td class="table-cell">@d.Name</td>
        <td class="table-cell table-desc">@d.Description</td>
        @await Html.PartialAsync("ActionTd", new ActionTdViewModel
        {
                Controller = "Department",
                Id = d.Id,
        })
    </tr>
}