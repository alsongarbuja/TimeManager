<aside class="sidebar">
    <div>
        <div class="sidebar-brand-container">
            <div class="sidebar-logo">
                <svg width="60" height="40" viewBox="0 0 201 176" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect y="30" width="120" height="120" rx="8" fill="#FFFFFF"/>
                    <path d="M59.584 137.024C57.4507 137.024 55.2747 136.555 53.056 135.616C50.9227 134.592 49.856 132.971 49.856 130.752V70.848C49.856 68.1173 50.5387 66.24 51.904 65.216C53.2693 64.192 54.3787 63.552 55.232 63.296H30.528C28.48 63.296 26.944 62.4 25.92 60.608C24.9813 58.7307 24.512 56.8107 24.512 54.848C24.512 52.7147 25.024 50.7947 26.048 49.088C27.072 47.296 28.5653 46.4 30.528 46.4H87.744C89.7067 46.4 91.2 47.296 92.224 49.088C93.248 50.7947 93.76 52.7147 93.76 54.848C93.76 56.8107 93.248 58.7307 92.224 60.608C91.2853 62.4 89.792 63.296 87.744 63.296H68.288V130.752C68.288 132.885 67.392 134.464 65.6 135.488C63.8933 136.512 61.888 137.024 59.584 137.024Z" fill="#1E1E1E"/>
                    <path d="M157.344 84.584C157.344 94.7387 158.581 102.035 161.056 106.472C163.531 110.824 167.2 113 172.064 113C175.136 113 177.824 112.787 180.128 112.36C182.432 111.848 184.523 111.592 186.4 111.592C189.813 111.592 192.288 112.317 193.824 113.768C195.36 115.133 196.128 116.925 196.128 119.144C196.128 122.045 195.061 124.264 192.928 125.8C190.88 127.336 188.235 128.403 184.992 129C181.835 129.597 178.592 129.896 175.264 129.896C166.048 129.896 158.709 128.189 153.248 124.776C147.872 121.363 143.989 116.328 141.6 109.672C139.296 102.931 138.144 94.568 138.144 84.584C138.144 74.6 139.296 66.152 141.6 59.24C143.989 52.2427 147.872 46.952 153.248 43.368C158.709 39.784 166.048 37.992 175.264 37.992C178.592 37.992 181.835 38.2907 184.992 38.888C188.235 39.4853 190.88 40.552 192.928 42.088C195.061 43.624 196.128 45.8427 196.128 48.744C196.128 50.8773 195.36 52.6693 193.824 54.12C192.288 55.5707 189.813 56.296 186.4 56.296C184.523 56.296 182.432 56.0827 180.128 55.656C177.824 55.144 175.136 54.888 172.064 54.888C166.091 54.888 162.123 57.32 160.16 62.184C158.283 66.9627 157.344 74.4293 157.344 84.584Z" fill="white"/>
                </svg>
            </div>
            <span class="sidebar-title">Time Clock</span>
        </div>
        <nav class="sidebar-nav-container">
            <a href="#main-content" class="skip-link">Skip to main content</a>

            @foreach (var grp in _links)
            {
                @if (User.IsInAnyRole(grp.ByRole))
                {
                    <div>
                        <span class="sidebar-group-label">@grp.Title</span>

                        <ul class="sidebar-nav-list">
                        @foreach (var link in grp.LinkData)
                        {
                            @if (User.IsInAnyRole(link.Roles))
                            {
                                var targetUrl = $"/app/{link.Url}";

                                bool IsActive = NavigationHelper.IsNavActive(ViewContext.HttpContext.Request.Path.ToString(), link.Url);
                                <li>
                                    <a href="@targetUrl" class="sidebar-link @(IsActive ? "is-active" : "")">
                                        <i class="@link.IconClass sidebar-link-icon"></i>
                                        <span>@link.Text</span>
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                    </div>
                }
            }

            @* <div>
                <span class="sidebar-group-label">Time Track</span>
                <ul class="sidebar-nav-list">
                    <li>
                        <SidebarNav Text="Time off requests"
                                    Url="/app/timeoff-request"
                                    IconClass="ri-list-check" />
                    </li>
                </ul>
            </div> *@
        </nav>
    </div>
</aside>

@functions {
    public class LinkGroup
    {
        public string Title { get; set; } = string.Empty;
        public List<LinkProps> LinkData { get; set; } = new();
        public string[] ByRole { get; set; } = [];
    }

    public class LinkProps
    {
        public string Text { get; set; } = string.Empty;
        public string Url { get; set; } = string.Empty;
        public string IconClass { get; set; } = string.Empty;
        public string[] Roles { get; set; } = [];
    }
}