@model TimeManager.Backend.ViewModels.SuperAdminDashboardSetupViewModel;

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard";
}

<style>
    .admin-banners-container {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        margin-bottom: 1.5rem;
    }

    .admin-banner {
        width: 100%;
        padding: 1rem 1.5rem;
        border-radius: 10px;
        box-sizing: border-box;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
    }

    .banner-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .banner-text {
        margin: 0;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .banner-warning {
        background-color: #fffbeb;
        border: 1px solid #fde68a;
        color: #92400e;
    }

    .banner-btn-warning {
        background-color: #b45309 !important;
        color: #ffffff !important;
        border: none !important;
    }

        .banner-btn-warning:hover {
            background-color: #92400e !important;
        }

    .warning-link {
        color: #92400e;
        font-weight: 600;
        font-size: 0.85rem;
        text-decoration: underline;
    }

        .warning-link:hover {
            color: #78350f;
        }

    .banner-danger {
        background-color: #fff1f2;
        border: 1px solid #fecdd3;
        color: #991b1b;
    }

    .banner-btn-danger {
        background-color: #dc2626;
        color: #ffffff;
    }

        .banner-btn-danger:hover {
            background-color: #b91c1c;
        }

    .banner-btn {
        padding: 0.45rem 1rem;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        font-size: 0.85rem;
        cursor: pointer;
        transition: background-color 0.15s ease;
    }
</style>

<h2>Task to setup the system</h2>

<div class="admin-banners-container">
    @if (!Model.HasNewSuperAdmin)
    {
        <div class="admin-banner banner-warning">
            <div class="banner-content">
                <p class="banner-text">Add a super admin user.</p>
                <button class="banner-btn btn-modal banner-btn-warning">Add</button>
            </div>
        </div>
    }

    @if (Model.HasNewSuperAdmin && Model.HasDefaultSuperAdmin)
    {
        <div class="admin-banner banner-danger">
            <div class="banner-content">
                <p class="banner-text">Remove default super admin.</p>
                <form>
                    <button class="banner-btn banner-btn-danger">Remove</button>
                </form>
            </div>
        </div>
    }

    <div class="admin-banner banner-warning">
        <div class="banner-content">
            <p class="banner-text">Do not forget to generate new pay period at end of the year.</p>
            <a asp-action="Index" asp-controller="PayPeriod" class="banner-action-link warning-link">Go to pay periods</a>
        </div>
    </div>
</div>

@section modalcontent {
    <div>
        <button class="btn-modal btn-modal-close"><i class="ri-close-circle-line"></i></button>
        @* <partial name="AddSuperAdminFormModal" /> *@
    </div>
}